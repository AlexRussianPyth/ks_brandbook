{
  "$description": "Дизайн-токены бренда «Каналсервис». Источник: Kanalservice_guide.pdf, раздел 2 «Визуальные константы» (стр. 20–28). Формат — W3C Design Tokens (https://tr.designtokens.org/format/).",

  "color": {
    "signal-blue": {
      "$type": "color",
      "$value": "#0041A0",
      "$description": "Сигнальный синий — основной цвет бренда",
      "cmyk": [100, 77, 0, 9],
      "rgb": [0, 65, 160],
      "pantone": "293C",
      "ral": "5005"
    },
    "signal-orange": {
      "$type": "color",
      "$value": "#FF4200",
      "$description": "Сигнальный оранжевый — главный акцент",
      "cmyk": [0, 77, 100, 0],
      "rgb": [255, 72, 0],
      "pantone": "1655C",
      "ral": "2005/2009"
    },
    "pure-white": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Чистый белый",
      "cmyk": [0, 0, 0, 0],
      "rgb": [255, 255, 255],
      "pantone": "WHITE"
    },
    "key-water": {
      "$type": "color",
      "$value": "#0096F0",
      "$description": "Ключевая вода",
      "cmyk": [100, 37, 0, 0],
      "rgb": [0, 150, 240],
      "pantone": "279C",
      "ral": "5012/5015"
    },
    "blue-bright": {
      "$type": "color",
      "$value": "#0064C8",
      "$description": "Вспомогательный синий (второй цвет фирменного узора)",
      "cmyk": [100, 60, 0, 0],
      "rgb": [0, 100, 200]
    },
    "blue-dark": {
      "$type": "color",
      "$value": "#003778",
      "$description": "Вспомогательный тёмно-синий",
      "cmyk": [0, 81, 90, 0],
      "rgb": [0, 55, 120]
    },
    "orange-dark": {
      "$type": "color",
      "$value": "#CE3200",
      "$description": "Вспомогательный тёмно-оранжевый",
      "cmyk": [12, 81, 90, 0],
      "rgb": [206, 50, 0]
    },
    "orange-light": {
      "$type": "color",
      "$value": "#FF6100",
      "$description": "Вспомогательный светло-оранжевый",
      "cmyk": [0, 70, 94, 0],
      "rgb": [255, 97, 0]
    },
    "gray": {
      "$type": "color",
      "$value": "#BEC3CE",
      "$description": "Вспомогательный серый",
      "cmyk": [30, 20, 15, 0],
      "rgb": [190, 195, 206]
    },
    "gray-light": {
      "$type": "color",
      "$value": "#E3E8ED",
      "$description": "Вспомогательный светло-серый",
      "cmyk": [13, 6, 6, 0],
      "rgb": [227, 232, 237]
    }
  },

  "role": {
    "primary": { "$type": "color", "$value": "{color.signal-blue}", "$description": "Основной фирменный цвет" },
    "accent": { "$type": "color", "$value": "{color.signal-orange}", "$description": "Акцент: кнопки, плашки логотипа, акцентные элементы" },
    "background": { "$type": "color", "$value": "{color.pure-white}" },
    "on-dark": { "$type": "color", "$value": "{color.pure-white}", "$description": "Текст и элементы на тёмном/фирменном фоне" }
  },

  "font": {
    "family": {
      "base": { "$type": "fontFamily", "$value": "Onest", "$description": "Основной шрифт текста и дескриптора (брендбук, стр. 26). Свободная лицензия OFL: https://fonts.google.com/specimen/Onest" }
    },
    "weight": {
      "thin": { "$type": "fontWeight", "$value": 100 },
      "extra-light": { "$type": "fontWeight", "$value": 200 },
      "light": { "$type": "fontWeight", "$value": 300 },
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semi-bold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "extra-bold": { "$type": "fontWeight", "$value": 800 },
      "black": { "$type": "fontWeight", "$value": 900 }
    }
  },

  "asset": {
    "logo-min-height": { "$type": "dimension", "$value": "4 mm", "$description": "Минимальный размер логотипа по высоте (брендбук, стр. 22)" }
  }
}
